{
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "pedidos_loja",
      "required": ["idTutor", "chaveIdempotencia", "status", "itens", "total", "moeda", "carrinhoVersao", "criadoEm", "atualizadoEm"],
      "additionalProperties": false,
      "properties": {
        "_id": { "bsonType": "objectId" },
        "idTutor": { "bsonType": "long" },
        "chaveIdempotencia": { "bsonType": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\z" },
        "status": { "enum": ["AGUARDANDO_PARCEIRO", "CANCELADO"] },
        "itens": {
          "bsonType": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "bsonType": "object",
            "required": ["slug", "nome", "categoria", "precoUnitario", "quantidade", "exemplo"],
            "additionalProperties": false,
            "properties": {
              "slug": { "bsonType": "string", "minLength": 3, "maxLength": 80, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\z" },
              "nome": { "bsonType": "string", "minLength": 1, "maxLength": 120 },
              "categoria": { "enum": ["ALIMENTACAO", "HIGIENE", "ACESSORIOS", "BRINQUEDOS"] },
              "precoUnitario": { "bsonType": ["int", "long"], "minimum": 0 },
              "quantidade": { "bsonType": ["int", "long"], "minimum": 1, "maximum": 99 },
              "exemplo": { "bsonType": "bool" }
            }
          }
        },
        "total": { "bsonType": ["int", "long"], "minimum": 0 },
        "moeda": { "enum": ["BRL"] },
        "carrinhoVersao": { "bsonType": "date" },
        "criadoEm": { "bsonType": "date" },
        "atualizadoEm": { "bsonType": "date" },
        "canceladoEm": { "bsonType": "date" }
      }
    }
  },
  "validationLevel": "strict",
  "validationAction": "error"
}
