# ==============================================================================
# KURA · Backend Tutor · .env.example
# Copie este arquivo para .env e preencha os valores ANTES de iniciar em prod.
# NUNCA commite o .env real — ele está no .gitignore.
# Gerar JWT_SECRET: openssl rand -base64 64
# ==============================================================================

# ── Profile ────────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Banco de Dados (Oracle FIAP) ───────────────────────────────────────────────
DB_URL=jdbc:oracle:thin:@//oracle.fiap.com.br:1521/orcl
DB_USERNAME=RM562999
DB_PASSWORD=

# ── JWT ────────────────────────────────────────────────────────────────────────
# Mínimo 64 bytes (512 bits) — gerado com: openssl rand -base64 64
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
