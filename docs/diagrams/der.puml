@startuml KURA_DER_v5_COMPLETO
' =============================================================================
' KURA · DER Completo — Schema v5 (kura_schema_v5.sql)
' FIAP Challenge 2026 · Oracle 19c
' Data: 2026-05-21 · Versão: 3.0 (completo — 26 tabelas + 3 views)
'
' Notação Barker (simulada em PlantUML):
'   #* = PK — identificador mandatório
'   *  = NOT NULL — atributo mandatório
'   o  = nullable — atributo opcional
'   <<UK>>       = UNIQUE constraint
'   <<FK→X>>     = FOREIGN KEY referenciando tabela X
'   <<CHK ...>>  = CHECK constraint
'   <<@Version>> = Optimistic locking JPA
'   <<IDENTITY>> = GENERATED BY DEFAULT AS IDENTITY (Java / Oracle 19c)
'   <<SEQ_x>>    = DEFAULT SEQ_x.NEXTVAL (.NET-owned + AGENDAMENTO)
'
' Cor das entidades:
'   Cinza   (#E0E0E0) = .NET owns — Java lê via @Immutable
'   Amarelo (#FFF9C4) = .NET cria; Java lê 1x no register-invite
'   Ciano   (#B2EBF2) = Java owns — PK via IDENTITY
'   Verde   (#C8E6C9) = Shared-write — ambos escrevem (NR_VERSION sincroniza)
'   Lilás   (#EDE7F6) = VIEWS — sem PK física
' =============================================================================

!theme plain
hide circle
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 70
skinparam BackgroundColor #FAFAFA
skinparam EntityFontSize 10
skinparam EntityFontName "Courier New"
skinparam EntityBorderColor #607D8B
skinparam EntityBorderThickness 1
skinparam ArrowColor #455A64
skinparam ArrowFontSize 8
skinparam ArrowFontColor #546E7A
skinparam LegendFontSize 10
skinparam LegendBorderColor #90A4AE

' =============================================================================
' GRUPO 1 — .NET OWNS (sem FK — nível 0)
' =============================================================================

entity "CLINICA" as CLINICA #E0E0E0 {
    #* ID_CLINICA : NUMBER(10)  <<SEQ_CLINICA>>
    --
    * NM_CLINICA : VARCHAR2(120)
    * NR_CNPJ : VARCHAR2(18)  <<UK>>
    o NM_RAZAO_SOCIAL : VARCHAR2(150)
    o DS_ENDERECO : VARCHAR2(200)
    o NM_CIDADE : VARCHAR2(80)
    o SG_UF : CHAR(2)
    o NR_CEP : VARCHAR2(9)
    o DS_TELEFONE : VARCHAR2(20)
    o DS_EMAIL : VARCHAR2(120)
    o DS_EMAIL_ACESSO : VARCHAR2(120)  <<UK>>
    o DS_SENHA_HASH : VARCHAR2(256)
    * DT_CADASTRO : TIMESTAMP
    * ST_ATIVA : CHAR(1)  <<CHK S|N>>
}

entity "ESPECIE" as ESPECIE #E0E0E0 {
    #* ID_ESPECIE : NUMBER(10)  <<SEQ_ESPECIE>>
    --
    * NM_ESPECIE : VARCHAR2(200)  <<UK>>
    * DT_CRIACAO : TIMESTAMP
    o DT_ATUALIZACAO : TIMESTAMP
}

entity "MEDICAMENTO" as MEDICAMENTO #E0E0E0 {
    #* ID_MEDICAMENTO : NUMBER(10)  <<SEQ_MEDICAMENTO>>
    --
    * NM_MEDICAMENTO : VARCHAR2(200)
    * DS_PRINCIPIO_ATIVO : VARCHAR2(500)
    * DS_APRESENTACAO : VARCHAR2(500)
    * DT_CRIACAO : TIMESTAMP
    o DT_ATUALIZACAO : TIMESTAMP
}

entity "TIPO_EVENTO" as TIPO_EVENTO #E0E0E0 {
    #* ID_TIPO_EVENTO : NUMBER(5)  <<SEQ_TIPO_EVENTO>>
    --
    * CD_TIPO : VARCHAR2(20)  <<UK>>
    * NM_TIPO : VARCHAR2(200)  <<UK>>
    o DS_TIPO : VARCHAR2(200)
    * ST_ATIVO : CHAR(1)  <<CHK S|N>>
    * DT_CRIACAO : TIMESTAMP
    o DT_ATUALIZACAO : TIMESTAMP
}

' =============================================================================
' GRUPO 2 — .NET OWNS (nível 1 — FK em CLINICA / ESPECIE)
' =============================================================================

entity "VETERINARIO" as VETERINARIO #E0E0E0 {
    #* ID_VETERINARIO : NUMBER(10)  <<SEQ_VETERINARIO>>
    --
    * ID_CLINICA : NUMBER(10)  <<FK>>
    * NM_VETERINARIO : VARCHAR2(200)
    o NR_CRMV : VARCHAR2(20)  <<UK>>
    o DS_EMAIL : VARCHAR2(150)  <<UK>>
    o NR_TELEFONE : VARCHAR2(20)
    * ST_ATIVO : CHAR(1)  <<CHK S|N>>
    * DT_CRIACAO : TIMESTAMP
    o DT_ATUALIZACAO : TIMESTAMP
}

entity "TUTOR" as TUTOR #E0E0E0 {
    #* ID_TUTOR : NUMBER(10)  <<SEQ_TUTOR>>
    --
    * ID_CLINICA : NUMBER(10)  <<FK>>
    * NM_TUTOR : VARCHAR2(200)
    * NR_CPF : VARCHAR2(11)  <<UK>>
    * DS_EMAIL : VARCHAR2(150)  <<UK>>
    * DS_TELEFONE : VARCHAR2(20)
    o DS_WHATSAPP : VARCHAR2(20)
    o DT_NASCIMENTO : DATE
    o DS_ENDERECO : VARCHAR2(200)
    o NM_CIDADE : VARCHAR2(80)
    o SG_UF : CHAR(2)
    o NR_CEP : VARCHAR2(9)
    * DT_CADASTRO : TIMESTAMP
    o DT_ATUALIZACAO : TIMESTAMP
    * ST_ATIVO : CHAR(1)  <<CHK S|N>>
    * ST_AVISO_PRIVACIDADE : CHAR(1)  <<CHK S|N>>
    o DT_AVISO_PRIVACIDADE : TIMESTAMP
    o DS_VERSAO_AVISO : VARCHAR2(20)
}

entity "RACA" as RACA #E0E0E0 {
    #* ID_RACA : NUMBER(5)  <<SEQ_RACA>>
    --
    * ID_ESPECIE : NUMBER(10)  <<FK>>
    * NM_RACA : VARCHAR2(80)  <<UK(NM_RACA,ID_ESPECIE)>>
    o DS_PREDISPOSICAO : VARCHAR2(500)
    * DT_CRIACAO : TIMESTAMP
    o DT_ATUALIZACAO : TIMESTAMP
}

' =============================================================================
' GRUPO 3 — PET + TUTOR_PET (.NET)
' =============================================================================

entity "PET" as PET #E0E0E0 {
    #* ID_PET : NUMBER(10)  <<SEQ_PET>>
    --
    * ID_CLINICA : NUMBER(10)  <<FK>>
    * ID_ESPECIE : NUMBER(10)  <<FK>>
    o ID_RACA : NUMBER(5)  <<FK>>
    o ID_VETERINARIO_RESP : NUMBER(10)  <<FK>>
    * NM_PET : VARCHAR2(80)
    o DT_NASCIMENTO : DATE
    o SG_SEXO : CHAR(1)  <<CHK M|F>>
    o SG_PORTE : CHAR(1)  <<CHK P|M|G>>
    * ST_ATIVO : CHAR(1)  <<CHK S|N>>
    * DT_CRIACAO : TIMESTAMP
    o DT_ATUALIZACAO : TIMESTAMP
}

entity "TUTOR_PET" as TUTOR_PET #E0E0E0 {
    #* ID_TUTOR : NUMBER(10)  <<FK, PK composta>>
    #* ID_PET : NUMBER(10)  <<FK, PK composta>>
    --
    * DS_VINCULO : VARCHAR2(50)
    * ST_PRINCIPAL : CHAR(1)  <<CHK S|N>>
    * DT_VINCULO : TIMESTAMP
}

' =============================================================================
' GRUPO 4 — EVENTO_CLINICO + SUBTIPOS (.NET)
' =============================================================================

entity "EVENTO_CLINICO" as EVENTO_CLINICO #E0E0E0 {
    #* ID_EVENTO : NUMBER(10)  <<SEQ_EVENTO_CLINICO>>
    --
    * ID_CLINICA : NUMBER(10)  <<FK>>
    o ID_PET : NUMBER(10)  <<FK>>
    o ID_VETERINARIO : NUMBER(10)  <<FK>>
    o ID_TIPO_EVENTO : NUMBER(5)  <<FK>>
    o DS_DESCRICAO : VARCHAR2(500)
    * DT_EVENTO : TIMESTAMP
    o DS_OBSERVACAO : VARCHAR2(1000)
    * DT_CRIACAO : TIMESTAMP
    o DT_ATUALIZACAO : TIMESTAMP
}

entity "CONSULTA" as CONSULTA #E0E0E0 {
    #* ID_CONSULTA : NUMBER(10)  <<SEQ_CONSULTA>>
    --
    * ID_EVENTO_CLINICO : NUMBER(10)  <<FK, UK>>
    * DS_MOTIVO : VARCHAR2(200)
    o DS_ANAMNESE : VARCHAR2(2000)
    o DS_EXAME_FISICO : VARCHAR2(2000)
    o DS_DIAGNOSTICO : VARCHAR2(1000)
    * DT_CONSULTA : TIMESTAMP
    * ST_ATIVA : CHAR(1)  <<CHK S|N>>
    * DT_CRIACAO : TIMESTAMP
    o DT_ATUALIZACAO : TIMESTAMP
}

entity "VACINA" as VACINA #E0E0E0 {
    #* ID_VACINA : NUMBER(10)  <<SEQ_VACINA>>
    --
    * ID_EVENTO_CLINICO : NUMBER(10)  <<FK>>
    * NM_VACINA : VARCHAR2(200)
    * NR_LOTE : VARCHAR2(50)
    * DS_FABRICANTE : VARCHAR2(200)
    o DT_PROXIMA_DOSE : TIMESTAMP
    * DT_CRIACAO : TIMESTAMP
    o DT_ATUALIZACAO : TIMESTAMP
}

entity "PRESCRICAO" as PRESCRICAO #E0E0E0 {
    #* ID_PRESCRICAO : NUMBER(10)  <<SEQ_PRESCRICAO>>
    --
    * ID_EVENTO_CLINICO : NUMBER(10)  <<FK>>
    * ID_MEDICAMENTO : NUMBER(10)  <<FK>>
    * DS_POSOLOGIA : VARCHAR2(500)
    * NR_DURACAO_DIAS : NUMBER(4)  <<CHK > 0>>
    * DT_CRIACAO : TIMESTAMP
    o DT_ATUALIZACAO : TIMESTAMP
}

entity "EXAME" as EXAME #E0E0E0 {
    #* ID_EXAME : NUMBER(10)  <<SEQ_EXAME>>
    --
    * ID_EVENTO_CLINICO : NUMBER(10)  <<FK>>
    * NM_EXAME : VARCHAR2(200)
    * DS_RESULTADO : VARCHAR2(1000)
    * DT_REALIZACAO : DATE
    * DT_CRIACAO : TIMESTAMP
    o DT_ATUALIZACAO : TIMESTAMP
}

entity "DOCUMENTO" as DOCUMENTO #E0E0E0 {
    #* ID_DOCUMENTO : NUMBER(10)  <<SEQ_DOCUMENTO>>
    --
    * ID_EVENTO_CLINICO : NUMBER(10)  <<FK>>
    * NM_ARQUIVO : VARCHAR2(200)
    * DS_TIPO_MIME : VARCHAR2(100)
    * DS_CAMINHO : VARCHAR2(500)
    * NR_TAMANHO_BYTES : NUMBER(15)
    * DT_CRIACAO : TIMESTAMP
    o DT_ATUALIZACAO : TIMESTAMP
}

' =============================================================================
' GRUPO 5 — NOTIFICACAO (.NET)
' =============================================================================

entity "NOTIFICACAO" as NOTIFICACAO #E0E0E0 {
    #* ID_NOTIFICACAO : NUMBER(10)  <<SEQ_NOTIFICACAO>>
    --
    * ID_CLINICA : NUMBER(10)  <<FK>>
    o ID_TUTOR : NUMBER(10)  <<FK>>
    o ID_VETERINARIO : NUMBER(10)  <<FK>>
    * DS_TITULO : VARCHAR2(200)
    * DS_MENSAGEM : VARCHAR2(500)
    * ST_LIDA : CHAR(1)  <<CHK S|N>>
    o DT_LEITURA : TIMESTAMP
    * DT_CRIACAO : TIMESTAMP
    o DT_ATUALIZACAO : TIMESTAMP
}

' =============================================================================
' GRUPO 6 — IoT (.NET)
' =============================================================================

entity "DISPOSITIVO_IOT" as DISPOSITIVO_IOT #E0E0E0 {
    #* ID_DISPOSITIVO : NUMBER(10)  <<SEQ_DISPOSITIVO_IOT>>
    --
    * ID_CLINICA : NUMBER(10)  <<FK>>
    * CD_DISPOSITIVO : VARCHAR2(20)  <<UK>>
    * DS_DESCRICAO : VARCHAR2(500)
    * DS_LOCALIZACAO : VARCHAR2(500)
    * DT_CRIACAO : TIMESTAMP
    o DT_ATUALIZACAO : TIMESTAMP
}

entity "LEITURA_TEMPERATURA" as LEITURA_TEMPERATURA #E0E0E0 {
    #* ID_LEITURA : NUMBER(15)  <<SEQ_LEITURA_TEMP>>
    --
    * ID_DISPOSITIVO_IOT : NUMBER(10)  <<FK>>
    * VL_TEMPERATURA : NUMBER(5,2)  <<CHK -40..80>>
    o VL_UMIDADE : NUMBER(5,2)
    * DT_LEITURA : TIMESTAMP
    * DT_CRIACAO : TIMESTAMP
    o DT_ATUALIZACAO : TIMESTAMP
}

entity "ALERTA_TEMPERATURA" as ALERTA_TEMPERATURA #E0E0E0 {
    #* ID_ALERTA : NUMBER(10)  <<SEQ_ALERTA_TEMP>>
    --
    * ID_LEITURA_TEMPERATURA : NUMBER(15)  <<FK>>
    * DS_TIPO_ALERTA : VARCHAR2(50)
    * VL_LIMITE : NUMBER(5,2)
    * DS_MENSAGEM : VARCHAR2(500)
    * ST_RESOLVIDO : CHAR(1)  <<CHK S|N>>
    * DT_CRIACAO : TIMESTAMP
    o DT_ATUALIZACAO : TIMESTAMP
}

' =============================================================================
' GRUPO 7 — TRIAGEM LUNA (.NET)
' =============================================================================

entity "TRIAGEM_LUNA" as TRIAGEM_LUNA #E0E0E0 {
    #* ID_TRIAGEM : NUMBER(10)  <<SEQ_TRIAGEM_LUNA>>
    --
    * ID_CLINICA : NUMBER(10)  <<FK>>
    o ID_TUTOR : NUMBER(10)  <<FK>>
    o ID_PET : NUMBER(10)  <<FK>>
    * DS_NIVEL_URGENCIA : VARCHAR2(20)
    * DS_DESCRICAO : VARCHAR2(2000)
    * ST_ENCAMINHADO_VET : CHAR(1)  <<CHK S|N>>
    * DT_TRIAGEM : TIMESTAMP
    * ST_ATIVA : CHAR(1)  <<CHK S|N>>
    * DT_CRIACAO : TIMESTAMP
    o DT_ATUALIZACAO : TIMESTAMP
}

' =============================================================================
' GRUPO 8 — INVITE_TUTOR (.NET cria; Java lê 1x)
' =============================================================================

entity "INVITE_TUTOR" as INVITE_TUTOR #FFF9C4 {
    #* ID_INVITE : NUMBER(10)  <<SEQ_INVITE_TUTOR>>
    --
    * ID_TUTOR : NUMBER(10)  <<FK ON DELETE CASCADE>>
    * NR_TOKEN : VARCHAR2(36)  <<UK>>
    * DT_EXPIRACAO : TIMESTAMP
    * DS_CANAL : VARCHAR2(20)  <<CHK WHATSAPP|EMAIL|SMS>>
    * ST_UTILIZADO : CHAR(1)  <<CHK S|N>>
    * ST_ATIVO : CHAR(1)  <<CHK S|N>>
    * DT_CRIACAO : TIMESTAMP
    o DT_ATUALIZACAO : TIMESTAMP
}

' =============================================================================
' GRUPO 9 — JAVA OWNS (IDENTITY PK)
' =============================================================================

entity "CONTA_TUTOR" as CONTA_TUTOR #B2EBF2 {
    #* ID_CONTA : NUMBER(10)  <<IDENTITY>>
    --
    * ID_TUTOR : NUMBER(10)  <<FK, UK_CONTA_TUTOR_TUTOR>>
    * DS_EMAIL_LOGIN : VARCHAR2(120)  <<UK>>
    * DS_SENHA_HASH : VARCHAR2(256)
    o ID_INVITE_USADO : NUMBER(10)  <<FK, UK_CONTA_INVITE_USED>>
    o DS_REFRESH_TOKEN_HASH : VARCHAR2(256)
    o DT_REFRESH_EXPIRA : TIMESTAMP
    * DT_CRIACAO : TIMESTAMP
    o DT_ULTIMO_LOGIN : TIMESTAMP
    * NR_TENTATIVAS_LOGIN : NUMBER(2)  <<CHK 0-99>>
    o DT_BLOQUEIO : TIMESTAMP
    * ST_ATIVA : CHAR(1)  <<CHK S|N>>
    * ST_EMAIL_VERIFICADO : CHAR(1)  <<CHK S|N>>
    o DS_TOKEN_RESET : VARCHAR2(256)
    o DT_TOKEN_EXPIRA : TIMESTAMP
}

entity "CONSENTIMENTO" as CONSENTIMENTO #B2EBF2 {
    #* ID_CONSENTIMENTO : NUMBER(10)  <<IDENTITY>>
    --
    * ID_TUTOR : NUMBER(10)  <<FK>>
    * DS_TIPO : VARCHAR2(40)  <<CHK TELEORIENTACAO|LEMBRETES|DADOS_ANONIMOS|COMPARTILHAR_SEGURADORA|MARKETING>>
    * DS_VERSAO_TERMO : VARCHAR2(20)
    o DS_TEXTO_TERMO : CLOB
    * ST_ACEITO : CHAR(1)  <<CHK S|N>>
    * DT_ACEITE : TIMESTAMP
    o DS_IP_ACEITE : VARCHAR2(45)
    o DT_REVOGACAO : TIMESTAMP
    o DS_IP_REVOGACAO : VARCHAR2(45)
}

entity "IDEMPOTENCY_KEY" as IDEMPOTENCY_KEY #B2EBF2 {
    #* ID_IDEMPOTENCY : NUMBER(10)  <<IDENTITY>>
    --
    * DS_KEY : VARCHAR2(64)  <<UK(DS_KEY,NM_RESOURCE)>>
    * NM_RESOURCE : VARCHAR2(60)
    * ID_RESOURCE_CRIADO : NUMBER(10)
    * DT_CRIACAO : TIMESTAMP
    * DT_EXPIRACAO : TIMESTAMP  <<CHK > DT_CRIACAO>>
}

' =============================================================================
' GRUPO 10 — SHARED-WRITE
' =============================================================================

entity "AGENDAMENTO" as AGENDAMENTO #C8E6C9 {
    #* ID_AGENDAMENTO : NUMBER(10)  <<SEQ_AGENDAMENTO>>
    --
    * ID_CLINICA : NUMBER(10)  <<FK>>
    o ID_TUTOR : NUMBER(10)  <<FK>>
    o ID_PET : NUMBER(10)  <<FK>>
    o ID_VETERINARIO : NUMBER(10)  <<FK>>
    o NM_PACIENTE : VARCHAR2(200)
    o DS_SERVICO : VARCHAR2(200)
    * DT_AGENDAMENTO : TIMESTAMP
    o NR_DURACAO_MINUTOS : NUMBER(4)
    * ST_STATUS : VARCHAR2(50)  <<CHK INTENCAO|AGENDADO|CONFIRMADO|REALIZADO|CANCELADO|NAO_COMPARECEU>>
    o DS_TIPO : VARCHAR2(30)
    o DS_ORIGEM : VARCHAR2(100)
    o DS_OBSERVACOES : VARCHAR2(1000)
    * DT_CRIACAO : TIMESTAMP
    o DT_CONFIRMACAO : TIMESTAMP
    o DT_CANCELAMENTO : TIMESTAMP
    o DS_MOTIVO_CANCEL : VARCHAR2(500)
    o ID_EVENTO_GERADO : NUMBER(10)  <<FK>>
    * NR_VERSION : NUMBER(10)  <<@Version>>
}

' =============================================================================
' GRUPO 11 — AUDITORIA
' =============================================================================

entity "LOG_ERRO" as LOG_ERRO #E0E0E0 {
    #* ID_LOG : NUMBER(15)  <<SEQ_LOG_ERRO>>
    --
    * NM_PROCEDURE : VARCHAR2(120)
    * NM_USUARIO : VARCHAR2(60)
    * DT_ERRO : TIMESTAMP
    * NR_CODIGO_ERRO : NUMBER(10)
    * DS_MENSAGEM_ERRO : VARCHAR2(2000)
    o DS_PARAMETROS : VARCHAR2(2000)
    o DS_STACK_TRACE : CLOB
}

' =============================================================================
' GRUPO 12 — VIEWS (read-only)
' =============================================================================

entity "VW_TIMELINE_PET" as VW_TIMELINE_PET #EDE7F6 {
    o ID_PET : NUMBER(10)
    --
    o ID_EVENTO : NUMBER(10)
    o NM_PET : VARCHAR2(80)
    o DT_EVENTO : TIMESTAMP
    o DS_TIPO_EVENTO : VARCHAR2(30)
    o ST_STATUS : VARCHAR2(50)
    o ID_CLINICA : NUMBER(10)
    o NM_CLINICA : VARCHAR2(120)
    ' Fonte: AGENDAMENTO JOIN PET JOIN CLINICA
}

entity "VW_VACINAS_VENCENDO" as VW_VACINAS_VENCENDO #EDE7F6 {
    o ID_PET : NUMBER(10)
    --
    o NM_PET : VARCHAR2(80)
    o ID_TUTOR : NUMBER(10)
    o NM_VACINA : VARCHAR2(30)
    o DT_PROXIMA_DOSE : TIMESTAMP
    o ID_CLINICA : NUMBER(10)
    o NM_CLINICA : VARCHAR2(120)
    ' Fonte: AGENDAMENTO com DS_TIPO=VACINA + proximos 30 dias
}

entity "VW_TIMELINE_CLINICA" as VW_TIMELINE_CLINICA #EDE7F6 {
    o ID_PET : NUMBER(10)
    --
    o NM_PET : VARCHAR2(80)
    o ID_EVENTO : NUMBER(10)
    o NM_TIPO_EVENTO : VARCHAR2(200)
    o CD_TIPO_EVENTO : VARCHAR2(20)
    o DT_EVENTO : TIMESTAMP
    o NM_VETERINARIO : VARCHAR2(200)
    o DS_OBSERVACAO : VARCHAR2(1000)
    o NM_CLINICA : VARCHAR2(120)
    ' Fonte: EVENTO_CLINICO JOIN PET JOIN VETERINARIO JOIN TIPO_EVENTO JOIN CLINICA
}

' =============================================================================
' RELACIONAMENTOS
' =============================================================================

' -- ESPECIE
ESPECIE             ||--|{ RACA                 : "classifica"
ESPECIE             ||--|{ PET                  : "é"

' -- CLINICA hub
CLINICA             ||--|{ VETERINARIO          : "vincula"
CLINICA             ||--|{ TUTOR                : "cadastra"
CLINICA             ||--|{ PET                  : "atende"
CLINICA             ||--|{ EVENTO_CLINICO       : "registra"
CLINICA             ||--|{ AGENDAMENTO          : "agenda"
CLINICA             ||--|{ NOTIFICACAO          : "gera"
CLINICA             ||--|{ DISPOSITIVO_IOT      : "monitora"
CLINICA             ||--|{ TRIAGEM_LUNA         : "recebe"

' -- RACA / VET → PET
RACA                ||--o{ PET                  : "raça de"
VETERINARIO         ||--o{ PET                  : "responsável"

' -- TIPO_EVENTO → EVENTO_CLINICO
TIPO_EVENTO         ||--o{ EVENTO_CLINICO       : "categoriza"

' -- VET → EVENTO / AGEND / NOTIF
VETERINARIO         ||--o{ EVENTO_CLINICO       : "registra"
VETERINARIO         ||--o{ AGENDAMENTO          : "atende"
VETERINARIO         ||--o{ NOTIFICACAO          : "recebe"

' -- TUTOR
TUTOR               ||--|{ TUTOR_PET            : "possui"
TUTOR               ||--|{ INVITE_TUTOR         : "recebe"
TUTOR               ||--|| CONTA_TUTOR          : "1 conta <<UK>>"
TUTOR               ||--|{ CONSENTIMENTO        : "consente"
TUTOR               ||--o{ AGENDAMENTO          : "solicita"
TUTOR               ||--o{ NOTIFICACAO          : "recebe"
TUTOR               ||--o{ TRIAGEM_LUNA         : "usa"

' -- PET
PET                 ||--|{ TUTOR_PET            : "pertence"
PET                 ||--o{ EVENTO_CLINICO       : "tem eventos"
PET                 ||--o{ AGENDAMENTO          : "é agendado"
PET                 ||--o{ TRIAGEM_LUNA         : "é triado"

' -- EVENTO_CLINICO → subtipos
EVENTO_CLINICO      ||--o| CONSULTA             : "detalha (1:1)"
EVENTO_CLINICO      ||--o{ VACINA               : "aplica"
EVENTO_CLINICO      ||--o{ PRESCRICAO           : "prescreve"
EVENTO_CLINICO      ||--o{ EXAME                : "solicita"
EVENTO_CLINICO      ||--o{ DOCUMENTO            : "anexa"

' -- PRESCRICAO → MEDICAMENTO
MEDICAMENTO         ||--o{ PRESCRICAO           : "compõe"

' -- INVITE → CONTA
INVITE_TUTOR        ||--o| CONTA_TUTOR          : "usado 1x <<UK>>"

' -- EVENTO → AGENDAMENTO (v5)
EVENTO_CLINICO      ||--o{ AGENDAMENTO          : "gera [v5]"

' -- IoT chain
DISPOSITIVO_IOT     ||--|{ LEITURA_TEMPERATURA  : "produz"
LEITURA_TEMPERATURA ||--|{ ALERTA_TEMPERATURA   : "dispara"

' -- Views (dependências lógicas — sem FK física)
AGENDAMENTO         ..> VW_TIMELINE_PET         : "alimenta"
AGENDAMENTO         ..> VW_VACINAS_VENCENDO     : "alimenta"
EVENTO_CLINICO      ..> VW_TIMELINE_CLINICA     : "alimenta"

' =============================================================================
' LEGENDA
' =============================================================================
legend bottom
  |= Cor          |= Proprietário               |= Acesso Java                        |
  | <#E0E0E0>     | .NET owns                   | @Immutable (read-only)              |
  | <#FFF9C4>     | .NET cria (INVITE_TUTOR)    | lê 1x em register-invite            |
  | <#B2EBF2>     | Java owns                   | lê + escreve (IDENTITY PK)          |
  | <#C8E6C9>     | Shared-write                | Java cria/edita; .NET PATCH status   |
  | <#EDE7F6>     | VIEW — sem PK física        | @Immutable / @Subselect             |
  |= Símbolo      |= Significado                                                      ||
  |  #*           | PK — identificador mandatório (Barker: barra sólida)              ||
  |  *            | NOT NULL — atributo mandatório                                     ||
  |  o            | nullable — atributo opcional                                       ||
  |  <<UK>>       | UNIQUE constraint                                                  ||
  |  <<FK>>       | FOREIGN KEY                                                        ||
  |  <<CHK>>      | CHECK constraint                                                   ||
  |  <<IDENTITY>> | GENERATED BY DEFAULT AS IDENTITY (JPA GenerationType.IDENTITY)    ||
  |  <<SEQ_x>>    | DEFAULT SEQ_x.NEXTVAL (JPA GenerationType.SEQUENCE)               ||
  |  @Version     | Optimistic locking JPA — Java/.NET via HTTP 409                   ||
  |  ..>          | Dependência de VIEW (sem FK física)                                ||
endlegend

@enduml
