    {
      "name": "7 — Agendamentos",
      "description": "CRUD de agendamentos. tutorId é sempre resolvido do JWT — nunca de query param.",
      "item": [
        {
          "name": "POST /agendamentos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('idAgendamento', String(body.idAgendamento));",
                  "    pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "    pm.test('Header Location presente', () => pm.expect(pm.response.headers.get('Location')).to.include('/agendamentos/'));",
                  "    pm.test('nrVersion retornado',       () => pm.expect(body.nrVersion).to.be.a('number'));",
                  "    pm.collectionVariables.set('nrVersion', String(body.nrVersion));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idPet\": 1,\n  \"idClinica\": 1,\n  \"idVeterinario\": null,\n  \"dtAgendamento\": \"2026-12-15T10:30:00\",\n  \"tipo\": \"CONSULTA\",\n  \"duracaoMinutos\": 30,\n  \"observacoes\": \"Consulta de rotina — criado via Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/agendamentos",
              "host": ["{{baseUrl}}"],
              "path": ["agendamentos"]
            },
            "description": "Cria agendamento. Status inicial: AGENDADO. Origem: PORTAL.\n\nPet deve pertencer ao tutor autenticado (403 caso contrário).\n\nO campo `nrVersion` é capturado automaticamente no test script — necessário para PUT."
          }
        },
        {
          "name": "GET /agendamentos (com filtros)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Resposta paginada', () => pm.expect(pm.response.json().content).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/agendamentos?page=0&size=10&sort=dtAgendamento,asc",
              "host": ["{{baseUrl}}"],
              "path": ["agendamentos"],
              "query": [
                { "key": "status",      "value": "AGENDADO",           "disabled": true },
                { "key": "dataInicio",  "value": "2026-01-01T00:00:00","disabled": true },
                { "key": "dataFim",     "value": "2026-12-31T23:59:59","disabled": true },
                { "key": "tipo",        "value": "CONSULTA",           "disabled": true },
                { "key": "page",        "value": "0" },
                { "key": "size",        "value": "10" },
                { "key": "sort",        "value": "dtAgendamento,asc" }
              ]
            },
            "description": "tutorId vem do JWT — não aceita `tutorId` como query param (segurança IDOR).\n\nFiltros opcionais desativados: habilitar conforme necessidade."
          }
        },
        {
          "name": "PUT /agendamentos/{id} (nrVersion obrigatório)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('nrVersion', String(body.nrVersion));",
                  "    pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "    pm.test('nrVersion incrementado', () => pm.expect(body.nrVersion).to.be.a('number'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dtAgendamento\": \"2026-12-20T14:00:00\",\n  \"dsTipoConsulta\": \"RETORNO\",\n  \"dsObservacoes\": \"Reagendado via Postman\",\n  \"idVeterinario\": null,\n  \"nrVersion\": {{nrVersion}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/agendamentos/{{idAgendamento}}",
              "host": ["{{baseUrl}}"],
              "path": ["agendamentos", "{{idAgendamento}}"]
            },
            "description": "Atualiza data, tipo ou observações.\n\n`nrVersion` é **obrigatório** — ausente retorna 400.\nVersão divergente (optimistic lock) retorna 409.\n\nO test script captura o novo `nrVersion` automaticamente."
          }
        },
        {
          "name": "PATCH /agendamentos/{id}/cancelar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Status CANCELADO', () => pm.expect(pm.response.json().status).to.equal('CANCELADO'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/agendamentos/{{idAgendamento}}/cancelar?motivo=Cancelado+via+Postman",
              "host": ["{{baseUrl}}"],
              "path": ["agendamentos", "{{idAgendamento}}", "cancelar"],
              "query": [
                { "key": "motivo", "value": "Cancelado via Postman" }
              ]
            },
            "description": "Cancela com motivo explícito. 409 se status for REALIZADO ou já CANCELADO."
          }
        },
        {
          "name": "DELETE /agendamentos/{id} (soft delete)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/agendamentos/{{idAgendamento}}",
              "host": ["{{baseUrl}}"],
              "path": ["agendamentos", "{{idAgendamento}}"]
            },
            "description": "Soft delete — muda ST_STATUS para CANCELADO. Nunca executa DELETE SQL.\n\n204 em sucesso. 409 se status for REALIZADO ou já CANCELADO."
          }
        }
      ]
    }

  ]
}
