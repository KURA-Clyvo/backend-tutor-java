    {
      "name": "6 — Consentimentos LGPD",
      "description": "Gestão de consentimentos (LGPD) — idempotência via Idempotency-Key.",
      "item": [
        {
          "name": "GET /tutores/{idTutor}/consentimentos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Array retornado', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/tutores/{{idTutor}}/consentimentos",
              "host": ["{{baseUrl}}"],
              "path": ["tutores", "{{idTutor}}", "consentimentos"]
            },
            "description": "Retorna o último registro de cada tipo (estado atual vigente). Para histórico completo use GET /lgpd/consentimentos."
          }
        },
        {
          "name": "POST /tutores/{idTutor}/consentimentos (Idempotency-Key obrigatório)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Gera UUID v4 para idempotência se ainda não definido",
                  "if (!pm.collectionVariables.get('idempotencyKey')) {",
                  "    function uuid() {",
                  "        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {",
                  "            const r = Math.random() * 16 | 0;",
                  "            return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);",
                  "        });",
                  "    }",
                  "    pm.collectionVariables.set('idempotencyKey', uuid());",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 ou 200 (idempotência)', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization",  "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",   "value": "application/json" },
              { "key": "Idempotency-Key","value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"MARKETING\",\n  \"versaoTermo\": \"v1.0\",\n  \"aceito\": \"S\",\n  \"textoTermo\": \"Aceito receber comunicações de marketing da Clyvo Vet.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tutores/{{idTutor}}/consentimentos",
              "host": ["{{baseUrl}}"],
              "path": ["tutores", "{{idTutor}}", "consentimentos"]
            },
            "description": "Header `Idempotency-Key` (UUID v4) é **obrigatório**.\n\n- 201: novo registro criado\n- 200: mesma key dentro de 24h → retorna registro original sem duplicar\n\nPre-request script gera UUID automaticamente. Para testar idempotência, reenvie a requisição sem alterar a variável `idempotencyKey`."
          }
        },
        {
          "name": "GET /tutores/{idTutor}/lgpd/relatorio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/tutores/{{idTutor}}/lgpd/relatorio",
              "host": ["{{baseUrl}}"],
              "path": ["tutores", "{{idTutor}}", "lgpd", "relatorio"]
            },
            "description": "Direito de acesso LGPD art. 18, I — agrega todos os dados pessoais do tutor."
          }
        },
        {
          "name": "GET /tutores/{idTutor}/lgpd/consentimentos (histórico)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Array retornado', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/tutores/{{idTutor}}/lgpd/consentimentos",
              "host": ["{{baseUrl}}"],
              "path": ["tutores", "{{idTutor}}", "lgpd", "consentimentos"]
            },
            "description": "Histórico completo (inclui revogações) — evidência de auditoria ANPD."
          }
        }
