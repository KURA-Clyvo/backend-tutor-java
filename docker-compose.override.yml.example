# ─── docker-compose.override.yml.example ──────────────────────────────────────
# Instruções:
#   1. Copie este arquivo: cp docker-compose.override.yml.example docker-compose.override.yml
#   2. Preencha os valores abaixo com suas credenciais FIAP
#   3. docker-compose.override.yml está no .gitignore — nunca comite credenciais
#
# O Docker Compose carrega o override automaticamente quando presente.
# ─────────────────────────────────────────────────────────────────────────────

services:
  kura-tutor:
    environment:
      # Oracle FIAP — substitua <SEU_RM> e <SUA_SENHA>
      DB_URL: jdbc:oracle:thin:@oracle.fiap.com.br:1521/orcl
      DB_USERNAME: <SEU_RM>
      DB_PASSWORD: <SUA_SENHA>

      # Segredo JWT — gere com: openssl rand -hex 32
      JWT_SECRET: <64-char-hex-string>

      # Opcional: aumentar expiração para dev confortável
      JWT_ACCESS_EXPIRATION_MINUTES: 60

      # Origens CORS permitidas em dev local
      CORS_ALLOWED_ORIGINS: http://localhost:3000,http://localhost:8081,http://localhost:19006
